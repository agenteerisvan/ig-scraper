# === Conta Instagram do Scraper ===
IG_USERNAME=seu_usuario_aqui
IG_PASSWORD=sua_senha_aqui

# === Configurações de Scraping ===
# Pausa entre acessos a perfis (segundos) — aumente se der "Check your Instagram"
SCRAPE_DELAY=3
# Máximo de workers simultâneos (browsers em paralelo)
MAX_WORKERS=2
# Timeout por página em ms
PAGE_TIMEOUT=20000
